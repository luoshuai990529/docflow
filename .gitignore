# Default deny: only source, deployment definitions, and maintained docs below
# are candidates for Git. Runtime/customer material remains local by default.
/*
!/.gitignore
!/README.md
!/Makefile
!/compose.yaml
!/.python-version
!/.node-version
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/scripts/
/scripts/*
!/scripts/test_tracked.py
!/server/
!/web/
!/deploy/
!/docs/
!/tests/

# Python application and its locked build metadata.
/server/*
!/server/.dockerignore
!/server/Dockerfile
!/server/container-entrypoint.sh
!/server/pyproject.toml
!/server/uv.lock
!/server/src/
!/server/src/autofill/
/server/src/autofill/**
!/server/src/autofill/**/
!/server/src/autofill/**/*.py
!/server/src/autofill/templates/product-doc.json
!/server/src/autofill/templates/supplier-pdf.json

# Vue browser source, locked dependencies, and local tests.
/web/*
!/web/.dockerignore
!/web/Dockerfile
!/web/nginx.conf
!/web/package.json
!/web/package-lock.json
!/web/index.html
!/web/vite.config.js
!/web/vite.config.mjs
!/web/vite.config.ts
!/web/public/
/web/public/*
!/web/public/static/
/web/public/static/*
!/web/public/static/document-questionnaire.svg
!/web/src/
/web/src/**
!/web/src/**/
!/web/src/**/*.js
!/web/src/**/*.mjs
!/web/src/**/*.vue
!/web/src/**/*.css
!/web/tests/
/web/tests/**
!/web/tests/**/
!/web/tests/**/*.js
!/web/tests/**/*.mjs

# Isolated document processor image and deployment instructions.
/deploy/*
!/deploy/README.md
!/deploy/processor/
/deploy/processor/*
!/deploy/processor/Dockerfile
!/deploy/processor/.dockerignore

# Versioned API contract and current architecture/operations documentation.
/docs/*
!/docs/api/
/docs/api/*
!/docs/api/openapi.yaml
!/docs/api/README.md
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/architecture.md
!/docs/architecture/workflow-nodes.md
!/docs/architecture/overview.png
!/docs/architecture/overview.html
!/docs/architecture/overview.archify.json
!/docs/architecture/workflow.drawio
!/docs/architecture/workflow.svg
!/docs/operations/
/docs/operations/*
!/docs/operations/operations.md

# Only individually audited, synthetic/local-fake test modules are trackable.
/tests/*
!/tests/__init__.py
!/tests/helpers.py
!/tests/integration/
/tests/integration/*
!/tests/integration/__init__.py
!/tests/integration/test_api_workflow_e2e.py
!/tests/unit/
/tests/unit/*
!/tests/unit/__init__.py
!/tests/test_answer_contract.py
!/tests/test_answer_correction.py
!/tests/test_answer_layout.py
!/tests/test_answer_support.py
!/tests/test_autonomous_answers.py
!/tests/test_autonomous_workflow.py
!/tests/test_catalog.py
!/tests/test_cli.py
!/tests/test_llm.py
!/tests/test_multisource_matching.py
!/tests/test_question_inventory.py
!/tests/test_repository_layout.py
!/tests/test_workflow_state.py
!/tests/unit/test_answer_strategy_boundaries.py
!/tests/unit/test_api_adapter.py
!/tests/unit/test_application_ports.py
!/tests/unit/test_core_workflow_nodes.py
!/tests/unit/test_document_adapter_boundaries.py
!/tests/unit/test_domain_contracts.py
!/tests/unit/test_office_apply_contract.py
!/tests/unit/test_workflow_runner_contract.py
!/tests/unit/test_write_plan_contract.py

# The allowlists above never override these local-only data and secret paths.
**/.env
**/.env.*
**/inputs/
**/analysis/
**/output/
**/data/
**/secrets/
**/var/
/results/
**/reports/
**/node_modules/
**/dist/
**/coverage/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/*.py[cod]
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.key
**/*.pem
**/*.log
